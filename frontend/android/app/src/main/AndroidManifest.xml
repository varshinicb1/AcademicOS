<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- image_picker's ImageSource.camera launches the system camera app,
         which needs this to write the captured photo somewhere image_picker
         can read it back from. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <!-- local_auth's real fingerprint/face/PIN check for the Biometric Auth
         toggle in Settings. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin.

         Real, device-confirmed bug (not a hypothesis): Scan and Grade's
         "Take photo" and "Import photo" buttons (image_picker / file_picker)
         did nothing at all on a real Android 14 device: no dialog, no crash,
         no launched activity, confirmed via `adb shell dumpsys activity`
         showing MainActivity stayed foreground and logcat showing zero
         related output. Root cause: on Android 11+ (API 30+),
         PackageManager.queryIntentActivities(), which these plugins use
         internally to resolve the camera capture and gallery pick intents,
         returns an empty list for any intent action not declared here,
         even when a real camera/gallery app is installed, so the pick call
         silently no-ops instead of throwing. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT"/>
            <data android:mimeType="image/*"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.PICK"/>
            <data android:mimeType="image/*"/>
        </intent>
        <intent>
            <action android:name="android.provider.action.PICK_IMAGES"/>
        </intent>
    </queries>
</manifest>
